# Local build of Arch's waybar package (0.15.0-3) plus two patches:
#  - tray-sticky-custom-icons.patch: keeps icons set through the tray's "icons"
#    config when an app pushes an icon update (which otherwise replaces them).
#  - hyprland-lua-dispatch.patch: backport of upstream's fix so clicking a workspace
#    works with Hyprland's Lua config (>= 0.55), which rejects the old dispatch
#    syntax. Drop it once a Waybar release includes it.
# pkgrel is kept just above the CachyOS repo build (3.1) so pacman doesn't replace it
# straight away; any newer repo build will, and this then needs a rebase and rebuild:
#   makepkg -si
#
# Maintainer: Brett Cornwall <ainola@archlinux.org>
# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Maxim Baz <archlinux at maximbaz dot com>
# Contributor: Parmjot Singh <parmjotsinghrobot at gmail dot com>

pkgname=waybar
pkgver=0.15.0
pkgrel=3.4
pkgdesc='Highly customizable Wayland bar for Sway and Wlroots based compositors'
arch=('x86_64')
url="https://github.com/Alexays/Waybar/"
license=('MIT')
depends=(
    'atkmm'
    'cairomm'
    'fmt'
    'glib2'
    'glibc'
    'glibmm'
    'gpsd'
    'gtk-layer-shell'
    'gtk3'
    'gtkmm3'
    'jack'
    'jsoncpp'
    'libdbusmenu-gtk3'
    'libevdev'
    'libgcc'
    'libinput'
    'libmpdclient'
    'libnl'
    'libpipewire'
    'libpulse'
    'libsigc++'
    'libstdc++'
    'libwireplumber'
    'libxkbcommon'
    'playerctl'
    'sndio'
    'spdlog'
    'systemd-libs'
    'upower'
    'wayland'
)
makedepends=(
    'catch2'
    'cmake'
    'meson'
    'glib2-devel' # gdbus-codegen
    'scdoc' # For generating manpages
    'wayland-protocols'
)
backup=(
    etc/xdg/waybar/config.jsonc
    etc/xdg/waybar/style.css
)
optdepends=(
    'otf-font-awesome: Icons in the default configuration'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Alexays/Waybar/archive/$pkgver.tar.gz"
        'tray-sticky-custom-icons.patch'
        'hyprland-lua-dispatch.patch')
b2sums=('3f0eb6cbf4ba189ddd37e82678ef87f877f6f48cf0bb699624c5d697c7164b11c3e25bf8fe382564c1e5891a6070d7c7e6d3009f8461a7087294dffccb78de95'
        'e57d05b77b8797fd77e184e89d816ed95f17a544ec4f261c3d39af9e819cdd205c43eb1a5b913a037033f4151bd5f94f5f4b6cc2d06c2967482ba50cfbecdb96'
        '249c373ad77d75753c483c1f880a400fa5499f9e197f5658944ac5c6074fc04d01c49540ddc7d7ce1ad92733e6274d1a843f9ed830bd6a28ee8e216bc75464cc')

prepare() {
    cd "Waybar-$pkgver"
    patch -Np1 -i "$srcdir/tray-sticky-custom-icons.patch"
    patch -Np1 -i "$srcdir/hyprland-lua-dispatch.patch"
}

build() {
    cd "Waybar-$pkgver"
    meson --prefix=/usr \
          --buildtype=plain \
          --auto-features=enabled \
          --wrap-mode=nodownload \
          -Dcpp_std=c++20 \
          -Dexperimental=true \
          -Dcava=disabled \
          -Dtests=enabled \
          build
    meson compile -C build
}

check() {
    cd "Waybar-$pkgver"
    # The hyprland socket-path tests pick up the live session's signature when this is
    # built from inside Hyprland (rather than a clean chroot) and fail, so hide it.
    env -u HYPRLAND_INSTANCE_SIGNATURE \
        meson test -C build --print-errorlogs --no-rebuild --suite waybar
}

package() {
    depends+=(
      'libatkmm-1.6.so'
      'libcairomm-1.0.so'
      'libgtk-3.so'
      'libjack.so'
      'libjsoncpp.so'
      'libpipewire-0.3.so'
      'libsndio.so'
      'libspdlog.so'
      'libudev.so'
      'libupower-glib.so'
    )

    cd "Waybar-$pkgver"
    meson install -C build --destdir "$pkgdir"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
