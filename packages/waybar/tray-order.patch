+/**
+ * Sort this item's tray according to the "order" config: items listed there come first,
+ * in the listed order, and all others keep their relative order after them. Items are
+ * matched like in the "icons" config, i.e. Electron's "chrome_status_icon_1" by tooltip.
+ * Runs once an item knows its id, as that is only available after its proxy is ready.
+ */
+void Item::applyOrder() {
+  if (order_.empty()) {
+    return;
+  }
+  static const Glib::Quark rank_key("waybar-tray-order");
+
+  const std::string key = id == "chrome_status_icon_1" ? tooltip.text.lowercase().raw() : id;
+  const auto listed = std::find(order_.begin(), order_.end(), key);
+  // 0 (no data) means unlisted
+  event_box.set_data(rank_key, listed == order_.end()
+                                   ? nullptr
+                                   : GINT_TO_POINTER(std::distance(order_.begin(), listed) + 1));
+
+  auto* box = dynamic_cast<Gtk::Box*>(event_box.get_parent());
+  if (box == nullptr) {
+    return;
+  }
+  const auto rank = [](Gtk::Widget* widget) {
+    const int value = GPOINTER_TO_INT(widget->get_data(rank_key));
+    return value == 0 ? INT_MAX : value;
+  };
+  auto children = box->get_children();
+  std::stable_sort(children.begin(), children.end(),
+                   [&rank](Gtk::Widget* a, Gtk::Widget* b) { return rank(a) < rank(b); });
+  for (std::size_t i = 0; i < children.size(); ++i) {
+    box->reorder_child(*children[i], static_cast<int>(i));
+  }
+}
