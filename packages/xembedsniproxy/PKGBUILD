# Local standalone build of KDE's xembedsniproxy, which Arch only ships inside
# plasma-workspace (and so drags in most of Plasma). It bridges legacy XEmbed tray
# icons (Wine/Proton apps such as Battle.net) to StatusNotifierItem so they show up
# in Waybar's tray instead of as a stray floating window.
#
# Builds just the xembed-sni-proxy directory of the official plasma-workspace
# tarball using our own CMakeLists.txt. Build and install with:
#   makepkg -si

pkgname=xembedsniproxy
pkgver=6.7.5
pkgrel=5
pkgdesc='Show legacy XEmbed tray icons in StatusNotifierItem trays (standalone build from plasma-workspace)'
arch=('x86_64')
url='https://invent.kde.org/plasma/plasma-workspace/-/tree/master/xembed-sni-proxy'
license=('LGPL-2.1-or-later')
depends=(
    'gcc-libs'
    'glibc'
    'kcoreaddons'
    'kcrash'
    'kdbusaddons'
    'kwindowsystem'
    'libx11'
    'libxcb'
    'libxtst'
    'qt6-base'
    'xcb-util'
    'xcb-util-image'
    'xcb-util-wm'
)
makedepends=(
    'cmake'
    'xorgproto'
)
conflicts=('plasma-workspace')
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-workspace-$pkgver.tar.xz"
        'CMakeLists.txt'
        'trim-icon-margin.patch'
        'window-class-id.patch'
        'hyprland-layout-coords.patch')
# Tarball checksum matches Arch's plasma-workspace package.
sha256sums=('94ab21e2243b7876f65c315f1e545081c6437f5bd0a041ca4fb6c2533ae874c9'
            'f6dbdaabd76a623139a34e3d48717b37da7dd9d8f2f159ea8e06d7ff8577547c'
            'd8ffe96435a4bc1d71e2373fcbee2f869026bcb736593d325df11fcb4a395a8d'
            'e8f400d426f6826cb804b317b27bdcddbb8c7fc828f3d73a092c44bca3a167b8'
            '5bf18e3e908e2fc63db34d2480b9ccbc2359365fe1f0d40673efc8b1a7123170')

prepare() {
    cp CMakeLists.txt "plasma-workspace-$pkgver/xembed-sni-proxy/CMakeLists.txt"
    # Crop the transparent margin Wine leaves around its icons, so they aren't shown
    # smaller than the other tray icons.
    patch -d "plasma-workspace-$pkgver" -Np1 -i "$srcdir/trim-icon-margin.patch"
    # Give icons without a window title (Wine again) their window class as ID instead
    # of a window number that changes every launch, so Waybar's "icons" can match them.
    patch -d "plasma-workspace-$pkgver" -Np1 -i "$srcdir/window-class-id.patch"
    # Translate click positions from Hyprland's monitor layout to Xwayland's, and move
    # them just outside the bar, so the menu a Wine app opens appears next to the tray
    # icon rather than offset by the layout difference or overlapping the bar.
    patch -d "plasma-workspace-$pkgver" -Np1 -i "$srcdir/hyprland-layout-coords.patch"
}

build() {
    cmake -B build -S "plasma-workspace-$pkgver/xembed-sni-proxy" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWORKSPACE_VERSION="$pkgver"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "plasma-workspace-$pkgver/LICENSES/LGPL-2.1-or-later.txt" \
        -t "$pkgdir/usr/share/licenses/$pkgname/"
}
