[
  {
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
                    "mode"          : "month",
                    "iso8601"       : true,
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffffff'><b>{}</b></span>",
                              "days":       "<span color='#ffffff'>{}</span>",
                              "weeks":      "<span color='#8a8a8a'>W{:%V}</span>",
                              "weekdays":   "<span color='#b0b0b0'><b>{}</b></span>",
                              "today":      "<span color='#aaffff'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "custom/control-center": {
      "format": " ",
      "tooltip": false,
      "on-click": "bash $HOME/.config/waybar/eww/scripts/toggle.sh"
    },
    "tray": {
      "icon-size": 16,
      "spacing": 10,
      "icons": {
        "Signal_status_icon_1": "/home/vizie/.config/waybar/icons/signal.svg",
        "bitwarden": "/home/vizie/.config/waybar/icons/bitwarden.svg",
        "wowup": "/home/vizie/.config/waybar/icons/wowup.svg",
        "Claude_status_icon_1": "/home/vizie/.config/waybar/icons/claude.svg",
        "steam_app_default": "/home/vizie/.config/waybar/icons/battlenet.svg",
        "faugus-launcher": "/home/vizie/.config/waybar/icons/faugus.svg",
        "steam": "/home/vizie/.config/waybar/icons/steam.svg",
        "tray-icon tray app opendeck": "/home/vizie/.config/waybar/icons/opendeck.svg"
      }
    },
    "custom/imsh-cast-monitor": {
      "format": "{text}",
      "exec": "/home/vizie/.nix-profile/bin/imsh-cast-monitor",
      "return-type": "json",
      "hide-empty-text": true
    },
    "height": 36,
    "hyprland/window": {
      "max-length": 60
    },
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "sort-by": "number"
    },
    "layer": "top",
    "modules-center": [
      "custom/imsh-cast-monitor",
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-right": [
      "tray",
      "custom/control-center"
    ],
    "position": "top",
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 15
  }
]
