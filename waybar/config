[
  {
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
                    "mode"          : "month",
                    "iso8601"       : true,
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{:%V}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "custom/power": {
      "format": "<span size='12288'>󰐥</span>",
      "on-click": "bash $HOME/.config/waybar/scripts/poweroff.sh"
    },
    "custom/mouse": {
      "exec": "bash $HOME/.config/waybar/scripts/mouse-battery.sh",
      "return-type": "json",
      "format": "<span size='12288'>{text}</span>",
      "interval": 30,
      "hide-empty-text": true
    },
    "custom/control-center": {
      "format": " ",
      "tooltip": false,
      "on-click": "bash $HOME/.config/waybar/eww/scripts/toggle.sh"
    },
    "tray": {
      "icon-size": 16,
      "spacing": 10
    },
    "pulseaudio#sink": {
      "scroll-step": 5,
      "format": "<span size='12288'>{icon}</span>  <span rise='1536'>{volume}%</span>",
      "format-muted": "<span size='12288'>󰝟</span>  {format_source}",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      }
    },
    "pulseaudio#source": {
      "scroll-step": 5,
      "format": "{format_source}",
      "format-source": "<span size='12288'>󰍬</span>  <span rise='1536'>{volume}%</span>",
      "format-source-muted": "<span size='12288'>󰍭</span>"
    },
    "cpu": {
      "format": "<span size='12288'>󰻠</span>  <span rise='1536'>{usage}%</span>",
      "interval": 1
    },
    "custom/imsh-cast-monitor": {
      "format": "{text}",
      "exec": "/home/vizie/.nix-profile/bin/imsh-cast-monitor",
      "return-type": "json",
      "hide-empty-text": true
    },
    "disk": {
      "format": "<span size='12288'>󰆓</span>  <span rise='1536'>{percentage_used}%</span>",
      "interval": 1,
      "path": "/"
    },
    "height": 36,
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "sort-by": "number"
    },
    "layer": "top",
    "memory": {
      "format": "<span size='12288'>󰍛</span>  <span rise='1536'>{percentage}%</span>",
      "interval": 1
    },
    "modules-center": [
      "custom/imsh-cast-monitor",
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-right": [
      "tray",
      "custom/control-center"
    ],
    "position": "top",
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 15
  }
]
